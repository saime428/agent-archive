{
  "name": "agent-frontend-vnext",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:preview": "npm run build && node scripts/stage-preview.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint . --max-warnings=0",
    "check:ui": "node scripts/check-ui-policy.mjs",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:served": "playwright test --config playwright.served.config.ts",
    "check": "npm run typecheck && npm run lint && npm run check:ui && npm run test:run && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@radix-ui/react-dialog": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.14",
    "lucide-react": "1.26.0",
    "monaco-editor": "0.56.0",
    "motion": "12.42.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "thinking-orbs": "0.2.0"
  },
  "overrides": {
    "dompurify": "3.4.12"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
